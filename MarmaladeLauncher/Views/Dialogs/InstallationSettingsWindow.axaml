<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:MarmaladeLauncher.Models"
             x:DataType="models:EngineInstallation"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MarmaladeLauncher.Views.Dialogs.InstallationSettingsWindow">
    
    <StackPanel Margin="20" Spacing="15">
        <TextBlock Text="Installation Settings" FontSize="18" FontWeight="Bold"/>

        <StackPanel Spacing="5">
            <TextBlock Text="Executable Path" FontSize="12" Foreground="Gray"/>
            <TextBox Text="{Binding ExecutablePath}" IsReadOnly="True" />
        </StackPanel>

        <StackPanel Spacing="5">
            <TextBlock Text="Command Line Arguments" FontSize="12" Foreground="Gray"/>
            <TextBox Text="{Binding Arguments, Mode=TwoWay}" Watermark="--no-splash" />
        </StackPanel>

        <Button Content="Save &amp; Close" 
                HorizontalAlignment="Right" 
                Click="OnCloseClick"
                Classes="accent"
                Margin="0,10,0,0"/>
    </StackPanel>
</UserControl>