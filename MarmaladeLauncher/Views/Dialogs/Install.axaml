<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MarmaladeLauncher.ViewModels"
             xmlns:localisation="clr-namespace:Common.Assets.Localisation;assembly=MarmaladeLauncher.Common"
             xmlns:models1="clr-namespace:MarmaladeLauncher.Models;assembly=MarmaladeLauncher.Common"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="550"
             x:DataType="vm:InstallationsViewModel"
             x:Class="MarmaladeLauncher.Views.Dialogs.Install">

    <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            CornerRadius="8"
            Padding="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MinWidth="720"
            MaxHeight="600">

        <Grid RowDefinitions="Auto, *, Auto">

            <TextBlock Grid.Row="0"
                       Text="{x:Static localisation:Resources.Modal_NewInstall_NewInstall}"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,15" />

            <TextBlock Grid.Row="1"
                       Text="{x:Static localisation:Resources.Modal_NewInstall_NoAvailableInstalls}"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,0,0,15"
                       IsVisible="{Binding !EngineVersionsAvailable}" />

            <Grid Grid.Row="1"
                  ColumnDefinitions="1*, 2*"
                  Margin="0,0,0,15"
                  IsVisible="{Binding EngineVersionsAvailable}">

                <!-- Left Column: Available Installations List -->
                <ListBox Grid.Column="0"
                         Margin="0,0,10,0"
                         ItemsSource="{Binding EngineInstallations}"
                         SelectedItem="{Binding SelectedEngineToInstall, Mode=TwoWay}"
                         Background="Transparent"
                         IsEnabled="{Binding !IsInstalling}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models1:LocalEngineInstallation">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Version}"
                                               FontWeight="Bold"
                                               FontSize="16" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Column="1"
                        Margin="10,0,0,0"
                        Padding="12"
                        Background="{DynamicResource SystemControlBackgroundChromeLowBrush}"
                        CornerRadius="6"
                        IsVisible="{Binding SelectedEngineToInstall, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Grid RowDefinitions="*, Auto">

                        <Grid Grid.Row="0" RowDefinitions="Auto, *">
                            <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,12">
                                <TextBlock Text="{Binding SelectedEngineToInstall.Name}"
                                           FontSize="18"
                                           FontWeight="Bold" />

                                <WrapPanel Orientation="Horizontal">
                                    <Border Background="{DynamicResource SystemAccentColorDark2}"
                                            CornerRadius="12"
                                            Padding="10,4"
                                            Margin="0,0,6,6">
                                        <TextBlock Text="{Binding SelectedEngineToInstall.Version, StringFormat='v{0}'}"
                                                   Foreground="White"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                    </Border>

                                    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                            CornerRadius="12"
                                            Padding="10,4"
                                            Margin="0,0,6,6">
                                        <TextBlock Text="{Binding SelectedEngineToInstall.FormattedInstallSize}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                    </Border>

                                    <Border Background="{DynamicResource SystemAccentColorLight2}"
                                            CornerRadius="12"
                                            Padding="10,4"
                                            Margin="0,0,6,6">
                                        <TextBlock Text="{Binding SelectedEngineToInstall.Branch}"
                                                   Foreground="Black"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </WrapPanel>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="8">
                                    
                                    <Expander HorizontalAlignment="Stretch"
                                              Header="Features"
                                              IsExpanded="True"
                                              Padding="8">
                                        <Panel>
                                            <ScrollViewer MaxHeight="150"
                                                          VerticalScrollBarVisibility="Auto"
                                                          IsVisible="{Binding SelectedEngineToInstall.HasFeatures}">
                                                <ItemsControl ItemsSource="{Binding SelectedEngineToInstall.Features}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                                                <TextBlock Text="•" Foreground="{DynamicResource SystemAccentColor}" />
                                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <TextBlock Text="No features specified for this version."
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                       FontStyle="Italic"
                                                       IsVisible="{Binding !SelectedEngineToInstall.HasFeatures}" />
                                        </Panel>
                                    </Expander>

                                    <Expander HorizontalAlignment="Stretch"
                                              Header="Changelog"
                                              IsExpanded="False"
                                              Padding="8">
                                        <Panel>
                                            <ScrollViewer MaxHeight="150"
                                                          VerticalScrollBarVisibility="Auto"
                                                          IsVisible="{Binding SelectedEngineToInstall.HasChangelog}">
                                                <ItemsControl ItemsSource="{Binding SelectedEngineToInstall.Changelog}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                                                <TextBlock Text="-" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <TextBlock Text="No changelog available for this build."
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                       FontStyle="Italic"
                                                       IsVisible="{Binding !SelectedEngineToInstall.HasChangelog}" />
                                        </Panel>
                                    </Expander>

                                    <Expander HorizontalAlignment="Stretch"
                                              Header="Install Configuration"
                                              IsExpanded="False"
                                              IsEnabled="{Binding !IsInstalling}"
                                              Padding="8">
                                        <StackPanel Spacing="10">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Installation Scope" 
                                                           FontSize="12" 
                                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                <ComboBox SelectedIndex="{Binding SelectedInstallScopeIndex, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch"
                                                          IsEnabled="{Binding !IsInstalling}">
                                                    <ComboBoxItem Content="User (Recommended)" />
                                                    <ComboBoxItem Content="System" />
                                                </ComboBox>
                                            </StackPanel>
                                            
                                            <StackPanel Spacing="4" IsVisible="{Binding IsLinux}">
                                                <TextBlock Text="Package Format" 
                                                           FontSize="12" 
                                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                <ComboBox SelectedIndex="{Binding PreferredLinuxPackageIndex, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch"
                                                          IsEnabled="{Binding !IsInstalling}">
                                                    <ComboBoxItem Content="Tar (Recommended)" />
                                                    <ComboBoxItem Content="Appimage" />
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel Spacing="4" IsVisible="{Binding IsMacOS}">
                                                <TextBlock Text="Package Format" 
                                                           FontSize="12" 
                                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                <ComboBox SelectedIndex="{Binding PreferredMacPackageIndex, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch"
                                                          IsEnabled="{Binding !IsInstalling}">
                                                    <ComboBoxItem Content="Universal (Recommended)" />
                                                    <ComboBoxItem Content="Tar" />
                                                </ComboBox>
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <StackPanel Grid.Row="1" Spacing="4" Margin="0,12,0,0" IsVisible="{Binding IsInstalling}">
                            <TextBlock Text="{x:Static localisation:Resources.Modal_NewInstall_DownloadingPrompt}"
                                       FontSize="12" Foreground="Gray" />
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadProgress}" Height="8" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Margin="10,0,0,0"
                        Padding="12"
                        Background="{DynamicResource SystemControlBackgroundChromeLowBrush}"
                        CornerRadius="6"
                        IsVisible="{Binding SelectedEngineToInstall, Converter={x:Static ObjectConverters.IsNull}}">
                    <TextBlock Text="{x:Static localisation:Resources.Modal_NewInstall_SelectPrompt}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </Border>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="*, Auto">
                <CheckBox Grid.Column="0"
                          Content="{x:Static localisation:Resources.Installations_FilterDevBuilds}"
                          IsChecked="{Binding ShowDevBuilds, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          IsEnabled="{Binding !IsInstalling}"
                          IsVisible="{Binding AllowDevBuilds}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Content="{x:Static localisation:Resources.Generic_Cancel}"
                            IsEnabled="{Binding !IsInstalling}"
                            Command="{Binding CloseInstallCommand}" />

                    <Button Content="{x:Static localisation:Resources.Modal_NewInstall_Install}"
                            Classes="accent"
                            Command="{Binding InstallEngineCommand}"
                            IsEnabled="{Binding !IsInstalling}"
                            IsVisible="{Binding SelectedEngineToInstall, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>