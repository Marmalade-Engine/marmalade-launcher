<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MarmaladeLauncher.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MarmaladeLauncher.Views.Dialogs.Install">
    <Border Background="White" 
            CornerRadius="8" 
            Padding="20" 
            HorizontalAlignment="Center" 
            VerticalAlignment="Center" 
            MinWidth="400">
        <StackPanel Spacing="15">
            <TextBlock Text="Install Options" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="Welcome to Avalonia!" />
            
            <Button Content="Close" 
                    HorizontalAlignment="Right" 
                    Command="{Binding $parent[UserControl;1].((vm:InstallationsViewModel)DataContext).CloseInstallCommand}" />
        </StackPanel>
    </Border>
</UserControl>