<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MarmaladeLauncher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:components="clr-namespace:MarmaladeLauncher.Views.Components"
        xmlns:pages="clr-namespace:MarmaladeLauncher.Views.Pages"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MarmaladeLauncher.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Marmalade Launcher"
        Icon="/Assets/icon.ico">
    
    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type vm:ProjectsViewModel}">
            <pages:ProjectsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstallationsViewModel}">
            <pages:InstallationsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <pages:SettingsView />
        </DataTemplate>
    </Window.DataTemplates>
    
    <SplitView IsPaneOpen="True" DisplayMode="Inline" OpenPaneLength="150">
        <SplitView.Pane>
            <components:SidebarView />
        </SplitView.Pane>

        <Border Padding="20">
            <TransitioningContentControl Content="{Binding CurrentPage}" />
        </Border>
    </SplitView>
    
</Window>
